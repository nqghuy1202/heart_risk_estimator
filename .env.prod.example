# Copy file này thành .env.prod trên VPS rồi điền giá trị THẬT (.env.prod đã bị gitignore, không commit):
#   cp .env.prod.example .env.prod
#
# Sinh giá trị random an toàn bằng: openssl rand -hex 32
# Dùng SECRET_KEY khác với financal_management/debt-crusher dù chạy chung VPS — không tái sử dụng
# secrets giữa các app.

DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=care.hlcompany.id.vn
